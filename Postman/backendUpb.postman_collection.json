{
  "info": {
    "name": "backendUpb - Productos",
    "description": "API de productos desplegada en Render. Ejecuta la colección en orden: primero se crea un producto y se guarda su id; las consultas, actualización y eliminación usan ese producto. Los errores de validación responden 400.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://backendupbtest-969u.onrender.com",
      "description": "Producción (Render)"
    },
    {
      "key": "localUrl",
      "value": "http://localhost:3000",
      "description": "Local: copia este valor en baseUrl para probar en tu PC"
    },
    {
      "key": "id",
      "value": "",
      "description": "Se completa automáticamente al ejecutar Crear producto. No uses un id ajeno para eliminar."
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        }
      }
    },
    {
      "name": "Crear producto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('id', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Laptop\",\n    \"precio\": 1500,\n    \"stock\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "Listar productos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    },
    {
      "name": "Buscar productos por nombre",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/productos?nombre=prueba",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ],
          "query": [
            {
              "key": "nombre",
              "value": "prueba",
              "description": "Texto a buscar (no distingue mayúsculas)"
            }
          ]
        }
      }
    },
    {
      "name": "Obtener producto por id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Actualizar producto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"precio\": 1350,\n    \"stock\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Eliminar producto",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{id}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos",
            "{{id}}"
          ]
        }
      }
    },
    {
      "name": "Crear producto inválido (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"precio\": -10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        }
      }
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expected = pm.info.requestName.includes(\"(400)\") ? 400 : pm.request.method === \"POST\" ? 201 : pm.request.method === \"DELETE\" ? 204 : 200;",
          "pm.test(\"Código HTTP esperado: \" + expected, function () { pm.response.to.have.status(expected); });"
        ]
      }
    }
  ]
}
